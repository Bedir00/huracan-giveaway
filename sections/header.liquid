<header class="site-header">
  {% if section.settings.show_announcement %}
    <div class="announcement-bar">
      <p>{{ section.settings.announcement_text | default: 'header.announcement_default' | t }}</p>
    </div>
  {% endif %}

  <div class="site-header__inner page-width">
    <button class="header__menu-toggle" aria-expanded="false" aria-controls="MobileNav" id="MobileNavToggle">
      <span></span><span></span><span></span>
      <span class="visually-hidden">{{ 'header.menu' | t }}</span>
    </button>

    <a href="{{ routes.root_url }}" class="site-header__logo">
      {% if section.settings.logo %}
        <img
          src="{{ section.settings.logo | image_url: width: 300 }}"
          alt="{{ shop.name }}"
          width="{{ section.settings.logo_width }}"
          height="{{ section.settings.logo_width | divided_by: section.settings.logo.aspect_ratio | default: section.settings.logo_width }}"
          loading="eager"
        >
      {% else %}
        <span class="site-header__logo-text">🐝 {{ shop.name }}</span>
      {% endif %}
    </a>

    <nav class="site-header__nav" aria-label="{{ 'header.menu' | t }}">
      <ul>
        {% for link in section.settings.menu.links %}
          <li>
            <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
            {% if link.links.size > 0 %}
              <ul class="site-header__submenu">
                {% for childlink in link.links %}
                  <li><a href="{{ childlink.url }}">{{ childlink.title }}</a></li>
                {% endfor %}
              </ul>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </nav>

    <div class="site-header__actions">
      <form action="{{ routes.search_url }}" method="get" class="header__search" role="search">
        <input type="search" name="q" placeholder="{{ 'general.search.placeholder' | t }}" aria-label="{{ 'general.search.title' | t }}" value="{{ search.terms }}">
        <input type="hidden" name="type" value="product">
        <button type="submit" aria-label="{{ 'general.search.submit' | t }}">{% render 'icon-search' %}</button>
      </form>

      <a href="{{ routes.account_url }}" class="header__account" aria-label="{{ 'header.account' | t }}">
        {% render 'icon-account' %}
      </a>

      <a href="{{ routes.cart_url }}" class="header__cart" aria-label="{{ 'header.cart' | t }}">
        {% render 'icon-cart' %}
        <span class="header__cart-count" data-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  <nav id="MobileNav" class="mobile-nav" aria-label="{{ 'header.menu' | t }}">
    <ul>
      {% for link in section.settings.menu.links %}
        <li>
          <a href="{{ link.url }}">{{ link.title }}</a>
          {% if link.links.size > 0 %}
            <ul>
              {% for childlink in link.links %}
                <li><a href="{{ childlink.url }}">{{ childlink.title }}</a></li>
              {% endfor %}
            </ul>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </nav>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo-Breite",
      "min": 60,
      "max": 260,
      "step": 10,
      "unit": "px",
      "default": 140
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Hauptmenü",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Ankündigungsbalken anzeigen",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Ankündigungstext",
      "default": "Kostenloser Versand ab 79 € innerhalb Deutschlands"
    }
  ]
}
{% endschema %}
