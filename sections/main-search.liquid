<section class="search page-width">
  <h1>{{ 'general.search.title' | t }}</h1>

  <form action="{{ routes.search_url }}" method="get" role="search" class="search__form">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}">
    <input type="hidden" name="type" value="product">
    <button type="submit">{{ 'general.search.submit' | t }}</button>
  </form>

  {% if search.performed %}
    <p class="search__results-count">
      {% if search.results_count > 0 %}
        {{ 'general.search.results_for' | t: terms: search.terms }} &ndash;
        {{ 'general.search.results_with_count' | t: count: search.results_count }}
      {% else %}
        {{ 'general.search.no_results' | t: terms: search.terms }}
      {% endif %}
    </p>

    {% if search.results.size > 0 %}
      <div class="collection__grid">
        {% for item in search.results %}
          {% if item.object_type == 'product' %}
            {% render 'product-card', product: item %}
          {% else %}
            <a href="{{ item.url }}" class="search__page-result">
              <h3>{{ item.title }}</h3>
              <p>{{ item.content | strip_html | truncate: 120 }}</p>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  {% endif %}
</section>

{% schema %}
{
  "name": "Suchergebnisse",
  "settings": []
}
{% endschema %}
