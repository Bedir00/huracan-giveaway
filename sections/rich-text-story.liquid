<section class="rich-text-story page-width">
  <div class="rich-text-story__media">
    {% if section.settings.image %}
      <img
        src="{{ section.settings.image | image_url: width: 900 }}"
        alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
        loading="lazy"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
      >
    {% else %}
      <div class="rich-text-story__placeholder">🐝</div>
    {% endif %}
  </div>
  <div class="rich-text-story__content">
    {% if section.settings.heading != blank %}
      <h2>{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.text != blank %}
      <div class="rich-text-story__text">{{ section.settings.text }}</div>
    {% endif %}
    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_link | default: '#' }}" class="button button--secondary">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Story / Über uns",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bild"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Von Imkern für Imker"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Bienenglück wurde von einer Imkerfamilie gegründet, die weiß, worauf es bei gutem Werkzeug ankommt. Wir testen jedes Produkt selbst am eigenen Bienenstand, bevor es in unser Sortiment aufgenommen wird.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button-Text",
      "default": "Mehr über uns"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button-Link"
    }
  ],
  "presets": [
    {
      "name": "Story / Über uns"
    }
  ]
}
{% endschema %}
