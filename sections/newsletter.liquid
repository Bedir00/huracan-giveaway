<section class="newsletter-section page-width">
  <div class="newsletter-section__inner">
    <h2>{{ section.settings.heading | default: 'general.newsletter.heading' | t }}</h2>
    <p>{{ section.settings.text | default: 'general.newsletter.text' | t }}</p>
    {% form 'customer', id: 'NewsletterSectionForm' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="newsletter-form__row">
        <label for="NewsletterSectionEmail" class="visually-hidden">{{ 'general.newsletter.placeholder' | t }}</label>
        <input
          type="email"
          name="contact[email]"
          id="NewsletterSectionEmail"
          placeholder="{{ 'general.newsletter.placeholder' | t }}"
          required
        >
        <button type="submit">{{ 'general.newsletter.button' | t }}</button>
      </div>
      {% if form.posted_successfully? %}
        <p class="newsletter-form__success">{{ 'general.newsletter.success' | t }}</p>
      {% endif %}
      {% if form.errors %}
        <p class="newsletter-form__error">{{ 'general.newsletter.error' | t }}</p>
      {% endif %}
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
